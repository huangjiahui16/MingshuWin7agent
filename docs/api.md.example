# 明枢Win7 — 模型接口预设（模板：这个文件是给人看的示例，不含任何密钥）
#
# 实际使用：把本文件复制成程序根目录的 api.md，再填自己的 key。
# 格式说明：
#   [预设名]          一段一个模型，名字随便起（英文小写最好）
#   label = 显示名    设置里下拉框看到的文字
#   base_url = 接口地址（OpenAI 兼容，一般以 /v1 结尾）
#   api_key = 密钥
#   model = 模型名
#
# 想预留别的模型：整段前面加 # 注释掉即可，随时解开就能用。
# 当前使用：deepseek

[deepseek]
label = DeepSeek（推荐，便宜、中文好）
base_url = https://api.deepseek.com/v1
api_key = 
model = deepseek-flash

[qwen]
label = 通义千问（阿里云 DashScope）
base_url = https://dashscope.aliyuncs.com/compatible-mode/v1
api_key = 
model = qwen-plus

#[kimi]
#label = Kimi（月之暗面）
#base_url = https://api.moonshot.cn/v1
#api_key = 
#model = moonshot-v1-8k

